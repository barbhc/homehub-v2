# ── Firebase (client-safe; none of these are secrets) ────────────────────────
# From Firebase console → Project settings → Your apps → Web app config.
# Leave unset for emulator-only dev (demo-homehub defaults apply).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (FCM) certificate key — console → Cloud Messaging → Web Push
# certificates. Required for browser push; leave unset to disable push. Also
# copy the config above into public/firebase-messaging-sw.js (not Vite-processed).
VITE_FIREBASE_VAPID_KEY=

# true = connect the app to the local Emulator Suite (npm run emu first)
VITE_USE_EMULATORS=false

# Sentry — error monitoring (optional)
VITE_SENTRY_DSN=

# --- Sentry source-map upload (BUILD-TIME ONLY, never reaches the client) ---
# Without these a production build still succeeds, but stack traces in Sentry
# stay minified — `at r (/assets/index-abc.js:487:5974)` and nothing more.
# The build prints a warning when they are absent.
#
# SENTRY_AUTH_TOKEN is a REAL SECRET (unlike the DSN, which is public by
# design and ships in the client bundle). Never commit it, never prefix it
# VITE_ — anything VITE_-prefixed is compiled into the client.
# Create at: Sentry -> Settings -> Auth Tokens, scope `project:releases`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=homehub
# Optional: override the release name. Defaults to the short git SHA.
SENTRY_RELEASE=

# PostHog — product analytics (optional; unset = analytics no-op). The project
# key is client-safe (like the Firebase config above). Host defaults to
# https://us.i.posthog.com when unset.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Apple sign-in stays a disabled stub until the Services ID + provider config
# (docs/DEFINITION_OF_DONE.md, Phase 7) — then flip to true.
VITE_APPLE_SIGNIN_ENABLED=false

# ── Server-side (Functions secrets via `firebase functions:secrets:set`) ─────
# Never put server secrets in VITE_ vars.
# ANTHROPIC_API_KEY      — parse worker, generate-tasks, ocr, chat, classify, etc.
# GOOGLE_VISION_API_KEY  — ocr (nameplate/receipt text detection)
# BRAVE_SEARCH_API_KEY   — product image search + chat web-search
