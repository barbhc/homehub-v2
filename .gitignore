*firebase-adminsdk*.json

# Git bundles (session-handoff artifacts, large binaries)
*.bundle

# Loose design assets (committed versions are in git already)
homehub_Logo.png
logo-canva.png
.vercel

# Loose dashboard design mockups (not app code)
dashboard-layouts.html
public/dashboard-layouts.html
scripts/parse-eval/results/
# Corpus PDFs downloaded from the owner's Storage — never commit (large + owner's docs)
scripts/parse-eval/.pdf-cache/
scripts/parse-eval/candidates/

# Functions build output
firebase/functions/lib
# Firebase emulator state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Apple private keys (App Store Connect API / APNs) — never commit
*.p8

# TestFlight feedback ledger — local triage state, not shared history
scripts/ops/.tf-seen.json

# Tester screenshots pulled by scripts/ops/testflight-feedback.mjs — these are
# real photos of testers' homes and phones. They belong on disk, never in git.
testflight-feedback/

# Same rule, second pull path: the testflight-feedback-review skill writes its
# inbox, ledger and built review page here. 18MB of the same photos, plus
# tester email addresses and their verbatim words. Local state only — the
# skill reads it off disk and the decisions land in docs/beta-feedback.md.
feedback/

# Manual-parser eval: downloaded corpus PDFs. ~80MB of other people's appliance
# manuals; runs/ is committed instead, which is what keeps the score
# reproducible without them.
evals/manual-parser/.pdf-cache/
