# ─────────────────────────────────────────────────────────────────────────
# E2E test environment.  Copy to `.env.test` (gitignored) and fill in.
# Used by:  npm run seed:test   and   npm run test:e2e
# ─────────────────────────────────────────────────────────────────────────

# Supabase project the tests run against. You can point this at your DEV
# project — the seed creates an ISOLATED throwaway user + home (named
# "E2E Test Home") and only ever touches that home's rows.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Service-role key — Supabase → Settings → API → service_role.
# Required ONLY by the seed script (to create/confirm the test auth user and
# bypass RLS while seeding). NEVER commit this; never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Throwaway test user the seed creates and the suite logs in as.
# (Defaults live in e2e/seed-config.ts if you omit these.)
TEST_USER_EMAIL=e2e@homehub.test
TEST_USER_PASSWORD=E2eTest!2026

# Optional: run the suite against a deployed preview instead of local dev.
# PLAYWRIGHT_BASE_URL=https://homehub-git-claude-redesign-frontend-...vercel.app
