rules_version = '2';

// Phase 1 placeholder — DENY ALL. The real membership-based rules are Phase 2
// (docs/firestore-model.md is written first; rules mirror v1's 78 RLS policies
// via the homes/{homeId}/members/{uid} primitive). Deny-all is the safe default
// until then; the emulator overrides nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
