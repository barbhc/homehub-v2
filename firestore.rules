rules_version = '2';

// Homehub v2 security rules — derived from docs/firestore-model.md §6.
//
// v1 had 78 RLS policies, but the effective model is simple: the near-universal
// data-table policy is `FOR ALL USING (home_id IN members-of(auth.uid()))` — any
// member of a home gets full CRUD on the home's data, with NO owner/admin/member
// distinction on data tables. Roles gate only member management. This file mirrors
// that: membership at homes/{homeId}/members/{uid} grants read+write to the home's
// subtree; role gates member writes; assignee-must-be-member is enforced inline.
//
// Rules do auth + shape ONLY, never joins (Firestore rules can't join or count docs;
// the last-owner guard and invite-token validation live in Phase 5 callables — see
// docs/firestore-model.md "Divergences from v1").

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isMember(homeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/homes/$(homeId)/members/$(request.auth.uid));
    }
    function memberRole(homeId) {
      return get(/databases/$(database)/documents/homes/$(homeId)/members/$(request.auth.uid)).data.role;
    }
    function isOwner(homeId) {
      return isMember(homeId) && memberRole(homeId) == 'owner';
    }
    // `createdBy` is a home's ownership anchor — the member-create rule below
    // trusts it to decide who may take the first owner row, so it must survive
    // every update unchanged. Compared via a defaulting get() so homes written
    // before the field existed stay editable (null == null), while ADDING the
    // field to such a home from the client is still refused.
    function createdByUnchanged() {
      return request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }
    // assignee (if present & non-null) must be a member of this home.
    function assigneeIsMember(homeId, field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || exists(/databases/$(database)/documents/homes/$(homeId)/members/$(request.resource.data[field]));
    }

    // ---- users (profiles + private prefs/tokens) ----
    match /users/{uid} {
      // Profile fields readable by any signed-in user ONLY as single-doc gets
      // (co-member display reads by uid). `list` stays closed — a collection
      // list would let any token (incl. anonymous) enumerate every user's
      // name + avatar. The app performs zero users-collection lists.
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if isSignedIn() && request.auth.uid == uid;

      // Private subtree: preferences (interface_level), FCM tokens — self only.
      match /private/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- homes ----
    match /homes/{homeId} {
      // A signed-in user may create a home, but MUST stamp it with their own uid
      // as `createdBy` (homeService.createHome). That field is what the member
      // create rule below checks before letting anyone take the owner row.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow read: if isMember(homeId);
      // Any member may edit the home profile, but nobody may rewrite createdBy —
      // otherwise a plain member could re-point the ownership anchor at
      // themselves, then delete and recreate their own member row as owner.
      allow update: if isMember(homeId) && createdByUnchanged();
      // Hard-deleting the whole home is the owner's call, not any member's.
      // (The app soft-deletes via deletedAt; this closes the destructive path.)
      allow delete: if isOwner(homeId);

      // ---- members (the rules primitive) ----
      match /members/{memberUid} {
        // Co-member reads within a home. The "find all my memberships"
        // collectionGroup query is served by a DEDICATED rule below (a mixed
        // condition here isn't statically provable for a LIST → denied).
        allow read: if isMember(homeId);
        // Self-create is ONLY the home-bootstrap case: whoever just created the
        // home takes its owner row. It is NOT an invite-join path — acceptInvite
        // runs on the Admin SDK and bypasses rules entirely, so a genuine invite
        // never needs client write access here.
        //
        // The previous rule (`uid == memberUid || isOwner`) never consulted the
        // invite and never looked at the home, so ANY signed-in user who learned a
        // homeId could write themselves in at any role — including owner — and
        // homeIds circulate: push deep-links carry ?home=<homeId>, and every
        // current and FORMER member knows one.
        //
        // getAfter (not get) is required: createHome commits the home doc and this
        // member doc in ONE batch, and get() cannot see the pending home write.
        allow create: if isSignedIn()
          && (
            (request.auth.uid == memberUid
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/homes/$(homeId)).data.get('createdBy', '') == request.auth.uid)
            || isOwner(homeId)
          );
        // Self-update (e.g. isPrimary) but NOT self-escalating role; owner may update
        // any member. Role changes are owner-only (blocks self-escalation).
        allow update: if isOwner(homeId)
          || (request.auth.uid == memberUid
              && request.resource.data.role == resource.data.role);
        // Self-leave or owner-removes-member. The last-owner guard is enforced in the
        // removeMember callable (rules can't count docs).
        allow delete: if request.auth.uid == memberUid || isOwner(homeId);
      }

      // ---- invites ----
      match /invites/{inviteId} {
        // Members-only: owners/admins manage invites from Settings (they're
        // members). Acceptance is NOT a client write — the acceptInvite callable
        // (Admin SDK) validates token+expiry and creates the member doc, so a
        // non-member never touches this collection directly. Restricting read to
        // members closes the token-harvesting hole (a signed-in non-member could
        // previously LIST /homes/{homeId}/invites given a homeId).
        // (A collection-group read rule for the accept-page token lookup is
        // deliberately deferred until sharing ships — see the checkpoint plan.)
        allow read, create, update, delete: if isMember(homeId);
      }

      // ---- task instances (assignee guard) ----
      match /taskInstances/{instId} {
        allow read: if isMember(homeId);
        allow create, update: if isMember(homeId) && assigneeIsMember(homeId, 'assignedTo');
        allow delete: if isMember(homeId);
      }

      // ---- task templates (defaultAssignee guard) ----
      match /taskTemplates/{tplId} {
        allow read: if isMember(homeId);
        allow create, update: if isMember(homeId) && assigneeIsMember(homeId, 'defaultAssignee');
        allow delete: if isMember(homeId);
      }

      // ---- manuals + chunks + entities (path-tenanted subtree) ----
      match /manuals/{manualId} {
        allow read, write: if isMember(homeId);
        match /{document=**} {
          allow read, write: if isMember(homeId);
        }
      }

      // ---- collections with child subcollections (nested wildcard, membership-gated) ----
      match /cleaningSessions/{sessionId} {
        allow read, write: if isMember(homeId);
        match /{document=**} { allow read, write: if isMember(homeId); }
      }
      match /chatConversations/{conversationId} {
        allow read, write: if isMember(homeId);
        match /{document=**} { allow read, write: if isMember(homeId); }
      }
      match /troubleshootingCases/{caseId} {
        allow read, write: if isMember(homeId);
        match /{document=**} { allow read, write: if isMember(homeId); }
      }

      // ---- task feedback (append-only ledger) + learned house rules ----
      // taskFeedback is the immutable audit trail: members append, nobody edits
      // or deletes (a correction is a new entry). houseRules are the machine-
      // applicable learned decisions — full member CRUD (soft-delete = isActive).
      match /taskFeedback/{feedbackId} {
        allow read, create: if isMember(homeId);
        allow update, delete: if false;
      }
      // parseFeedback is the same contract at parse time: "these tasks don't look
      // right", plus the corrections the reviewer already made. Append-only — a
      // second opinion is a new entry, never an edit of the first.
      match /parseFeedback/{feedbackId} {
        allow read, create: if isMember(homeId);
        allow update, delete: if false;
      }
      match /houseRules/{ruleId}       { allow read, write: if isMember(homeId); }

      // ---- flat member-CRUD collections ----
      match /rooms/{roomId}            { allow read, write: if isMember(homeId); }
      match /items/{itemUnitId}        { allow read, write: if isMember(homeId); }
      match /careNotes/{noteId}        { allow read, write: if isMember(homeId); }
      match /chatFaqs/{faqId}          { allow read, write: if isMember(homeId); }
      match /shoppingList/{itemId}     { allow read, write: if isMember(homeId); }
      match /tierChangeLog/{logId}     { allow read, write: if isMember(homeId); }
      match /serviceProviders/{provId} { allow read, write: if isMember(homeId); }
    }

    // ---- global catalog: read authed, write server-only (Admin SDK) ----
    match /supplyCatalog/{supplyItemId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /options/{optionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ---- global server-only caches (Admin SDK reads/writes; clients get nothing) ----
    match /webRetrievals/{id}      { allow read, write: if false; }
    match /productLookupCache/{id} { allow read, write: if false; }
    // Phase-D graduation candidates: written by the graduateFeedback scheduler,
    // read by the maintainer eval script — both Admin SDK. Never client-visible
    // (they aggregate cross-home feedback).
    match /parseEvalCandidates/{id} { allow read, write: if false; }

    // Collection-group read for "find all MY memberships"
    // (homeService.getPrimaryHome/getHomes run
    // collectionGroup("members").where("uid","==",me)). A clean, statically
    // provable field check — the where-clause guarantees resource.data.uid ==
    // request.auth.uid, so the LIST is allowed. Writes/co-member reads stay on the
    // path-scoped /homes/{homeId}/members rule above.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
