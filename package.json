{
  "name": "homehub-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:watch": "vitest",
    "emu": "firebase emulators:start --project demo-homehub",
    "dev:emu": "VITE_USE_EMULATORS=true vite",
    "seed:emu": "tsx scripts/seed-emulator.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emu": "firebase emulators:exec --only firestore --project demo-homehub-rules \"npm run test:rules\"",
    "test:worker:emu": "npm --prefix firebase/functions run build && firebase emulators:exec --only firestore --project demo-homehub \"node --test firebase/functions/test/*.test.mjs\"",
    "test:e2e:emu": "firebase emulators:exec --only auth,firestore --project demo-homehub \"npm run seed:emu && playwright test --config playwright.emu.config.ts\"",
    "lint:new": "eslint src/integrations shared e2e/smoke scripts/seed-emulator.ts firebase/functions/src"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@sentry/react": "^10.48.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.4.0",
    "firebase": "^12.9.0",
    "lucide-react": "^0.563.0",
    "pdfjs-dist": "^4.10.38",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.0.2",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "pdf-parse": "^1.1.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
