rules_version = '2';

// v2 Storage rules. v1's `Manuals` bucket was PUBLIC-read (the app + parse edge
// functions fetched manuals/photos by public URL), so we mirror that posture:
// public read, authenticated write. The parse worker fetches upload PDFs via the
// Admin SDK (bypasses rules), so reads here are only for client display.
//
// Path conventions (preserved from v1):
//   {userId}/{itemId}/manual_*.{ext}     — manual PDFs
//   photos/{userId}/{itemId}/photo.{ext} — item photos
//   receipts/{itemUnitId}/*              — receipts
//   images/{manualId}/page_*.jpg         — rendered diagram pages
//
// Follow-up (deferred): tighten write to per-user / per-home path scoping once
// the sharing model is enabled.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
