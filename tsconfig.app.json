{
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  // Node-API static guards (fs scans of the repo) — vitest runs them fine, but
  // this browser-lib config can't type node:fs.
  "exclude": ["src/test/indexCoverage.test.ts", "src/test/noUnhandledFetch.test.ts", "src/test/overlayLayering.test.ts", "src/test/chrisRound1.test.ts", "src/components/smart-add/addFlowCopy.test.ts", "src/test/csp.test.ts"]
}
